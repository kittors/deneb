# Copy to test/topo/.accept/gui.env (ignored by git) and set what differs
# here; shoot.sh reads it. Defaults are in shoot.sh.

# The Windows test machine, over ssh, and its name in known_hosts (the
# address it was first reached at). On the same LAN as this Mac, its LAN
# address copies the window faster than Tailscale does.
#WIN_SSH=Administrator@<LAN address>
#WIN_ALIAS=100.122.56.85

# The Ubuntu virtual machine (VMware Fusion), and the folder with its
# user's password, ssh key and known_hosts.
#U26_VMX="$HOME/Virtual Machines.localized/Ubuntu 26.04 Deneb.vmwarevm/Ubuntu 26.04 Deneb.vmx"
#U26_SECRETS="$HOME/VMs/deneb-u26"
#U26_USER=mia
#U26_SNAPSHOT=clean-os-no-deneb
