+			r.rec(600)
+			click(r, mark(r))
+			r.rec(700)
+			r.shot("需要重新登录")
+			click(r, at(r, "续上"))
+			r.rec(3200)
+			r.shot("续上了")
+		}},
+		// The switches: one LAN paused, then both, and the mark goes hollow.
+		{"menubar-pause", func(r *rig) {
+			r.rec(300)
+			click(r, mark(r))
+			r.rec(700)
+			click(r, at(r, "暂停周末联机"))
+			r.rec(900)
+			r.shot("暂停一个")
+			click(r, at(r, "暂停工作室"))
+			r.rec(900)
+			r.shot("都暂停了")
+			click(r, at(r, "暂停周末联机"))
+			r.rec(1000)
+		}},
+		// This computer's Deneb stops: the panel says so, and the mark goes
+		// hollow; it comes back.
+		{"menubar-engine", func(r *rig) {
+			r.rec(300)
+			click(r, mark(r))
+			r.rec(700)
+			r.d.Simulate("engine")
+			r.rec(1000)
