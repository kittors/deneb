+					f.Close()
+				}
+			}
+			r.move = func(to ui.Point, ms int) {
+				from := pointer
+				steps := max(1, ms*60/1000)
+				for i := 1; i <= steps; i++ {
+					k := ui.EaseInOut(float32(i) / float32(steps))
+					tt.Move(from.X+(to.X-from.X)*k, from.Y+(to.Y-from.Y)*k)
+					r.rec(17)
+				}
+				pointer = to
+			}
