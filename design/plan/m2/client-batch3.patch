+// menuBar puts Deneb's mark in the menu bar, and under it the panel a click
+// opens (DESIGN §7.1). The mark follows the world: a dot while something
+// waits for me, an outline while nothing connects here. It returns the
+// panel, or nil where the system has no menu bar to put it in.
+func menuBar(a *app, w *mygo.Window) *mygo.Window {
+	tray, err := mygo.NewTray(mygo.TrayOptions{ID: "deneb", Icon: trayIcons["solid"], IconIsTemplate: true, ToolTip: "Deneb"})
+	if err != nil {
+		log.Printf("deneb: no menu bar mark: %v", err)
+		return nil
+	}
+	panel := mygo.NewFlyout(mygo.FlyoutOptions{
+		Tray: tray, Placement: mygo.PlacementBottom, Gap: 6,
+		Width: panelWidth, Height: 360, Focusable: true, Shadow: true, CornerRadius: 20, Hidden: true,
+		Content: ui.View(a.panel),
+	})
+	open := func() {
+		if panel.IsVisible() {
+			panel.Hide()
+			return
+		}
+		panel.Show()
+	}
+	tray.OnClick(open)
+	tray.OnRightClick(open)
+	// Closed by a click elsewhere, or Escape: what it held goes now.
+	panel.OnClose(func(*mygo.CloseEvent) { a.post(func(c *ui.Context) { a.flushPanel(c) }) })
+	a.showMain = func() {
+		panel.Hide()
+		w.Show()
+		w.Focus()
+	}
+	a.resizePanel = func(h int) { panel.SetSize(panelWidth, h) }
+	var was atomic.Value
+	mark := func(s *model.Snapshot) {
+		if st := trayState(s, time.Now()); was.Swap(st) != st {
+			tray.SetIcon(trayIcons[st], true)
+		}
+	}
+	mark(a.store.Snapshot())
+	a.store.Subscribe(mark)
+	return panel
+}
+
+// trayIcons are the menu bar's marks, drawn by TestTrayIcons.
+var trayIcons = func() map[string][]byte {
+	out := map[string][]byte{}
+	for _, st := range []string{"solid", "dot", "hollow"} {
+		b, err := trayIconFiles.ReadFile("trayicons/" + st + ".png")
+		if err != nil {
+			panic(err)
+		}
+		out[st] = b
+	}
+	return out
+}()
+
+//go:embed trayicons/*.png
+var trayIconFiles embed.FS
 
