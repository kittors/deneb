+	if !ok {
+		off = &ui.Point{}
+		a.ballOffs[id] = off
+	}
+	b.Draggable(off, ui.DraggableOptions{Animation: ui.Snappy})
+	b.Cursor(ui.CursorGrab)
+	if a.ballHome == nil {
