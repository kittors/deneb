+			b.AnimatePose(pressPose(b, 0.92), ui.Snappy)
+			b.Children(func() { ui.Icon(c, deviceGlyphs[k.glyph]).Size(18, 18).TextColor(p.ink2) })
+			if b.Clicked() {
+				a.picking = false
+				if k.glyph != d.kind {
+					a.send(c, model.Op{Kind: model.OpDeviceSetKind, Device: model.DeviceID(d.id), DevKind: k.kind})
+				}
+			}
+		}
+	})
+}
