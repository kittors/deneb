+// ago is how long ago, in a few words: "3 小时前", "昨天", "40 天前".
+func ago(d time.Duration) string {
+	switch {
+	case d < time.Minute:
+		return "刚刚"
+	case d < time.Hour:
+		return strconv.Itoa(int(d.Minutes())) + " 分钟前"
+	case d < 24*time.Hour:
+		return strconv.Itoa(int(d.Hours())) + " 小时前"
+	case d < 48*time.Hour:
+		return "昨天"
+	}
+	return strconv.Itoa(int(d.Hours()/24)) + " 天前"
+}
