+// sameName reports whether another device on the canvas has d's name.
+func (a *app) sameName(d *device) bool {
+	if d.id == a.self {
+		return false
+	}
+	for _, o := range a.devices {
+		if o != d && o.id != a.self && o.name == d.name && o.gone.IsZero() {
+			return true
+		}
+	}
+	return false
+}
