+	}
+	if r.tt.HasText("新设备要我同意") || r.tt.HasText("新成员要我同意") {
+		t.Error("the LAN's card offers switches the server cannot keep")
+	}
+	r.tt.ClickAt(sidebarWidth+300, headerHeight+600)
+	r.settle(400 * time.Millisecond)
