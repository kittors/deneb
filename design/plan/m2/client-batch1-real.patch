+		t.Fatalf("构建服务器's card did not open: %q", r.a.selected)
+	}
+	card := ui.Point{X: r.a.origin.X + r.a.cardAt.X, Y: r.a.origin.Y + r.a.cardAt.Y}
+	r.tt.ClickAt(card.X+16+40+12+30, card.Y+16+9) // its name
+	r.settle(300 * time.Millisecond)
+	if r.a.renaming == nil {
