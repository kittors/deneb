+	r.settle(600 * time.Millisecond)
+	jie := r.a.people[string(fakeworld.Jie)]
+	b, ok := r.tt.Find(jie.ch)
+	if !ok {
+		t.Fatalf("no ball of 阿杰's in the header: %q", r.tt.Texts())
