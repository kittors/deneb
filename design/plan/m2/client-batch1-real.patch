+	r.until("the new name", func() bool { return r.store().Devices[model.DeviceID(build)].Name == "编译机" })
+	r.tt.ClickAt(sidebarWidth+60, 36) // the LAN's name
+	r.settle(500 * time.Millisecond)
+	if r.a.selected != lanCard {
