{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "deneb-demos",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4318",
        "--bind",
        "127.0.0.1",
        "--directory",
        "design/demos"
      ],
      "port": 4318
    },
    {
      "name": "deneb-control-dev",
      "runtimeExecutable": "go",
      "runtimeArgs": [
        "run",
        "./cmd/deneb-control",
        "-dev",
        "-dev-reset",
        "-listen",
        "127.0.0.1:47090",
        "-data",
        "/tmp/deneb-control-preview"
      ],
      "port": 47090
    }
  ]
}
