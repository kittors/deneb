# deploy/front/front.<host>.env: what deploy/front/deploy.sh starts on
# <host>. Copy this file; the copy stays out of the repository, as it holds
# the control server's address.

# Where deneb-front listens, on the machine the devices can reach.
LISTEN=:47443

# The control server's -front-listen: its address and port. The control
# server lists this machine in -front-from, or it closes the connections.
DENEB_FRONT_TO=198.51.100.1:47444
