# What the Web version's scripts need to know about one deployment
# (design/plan/m7/web-deploy.md). Copy this to site.hkspare.env, which is
# not in the repository (.gitignore), and fill it in. The scripts read it as
# shell: NAME=value, no spaces around =, values with spaces in quotes.

# The name browsers reach the Web version by. Its DNS A record points at
# the machine deneb-web runs on; with Cloudflare, DNS only (not proxied).
WEB_HOST=deneb.example.com

# deneb-web's port, on 127.0.0.1 only: nginx passes the name's requests to
# it. One no one uses there (deploy-hkspare.sh checks).
WEB_PORT=47447

# The control server deneb-web passes /api/ on to, trusting its key as
# devices do. Empty CONTROL_PIN: read from hk-155's data/tls/pin.txt.
CONTROL_URL=https://103.42.31.155:47443
CONTROL_PIN=

# How nginx's other sites on that machine listen, copied, ;-separated (see
# grep -h listen /etc/nginx/conf.d/*.conf). The new site must listen the
# same way: a site that names an address takes that address from every
# site that does not, and a socket's options (http2) are shared.
NGINX_LISTEN_80="80"
NGINX_LISTEN_443="443 ssl"

# The new site's file in /etc/nginx/conf.d/. nginx makes the first server on
# an address its default (for names it does not know, and requests by
# address) unless one says default_server, so the file must sort after the
# other sites' files: nginx-hkspare.sh refuses otherwise. Empty:
# zz-<WEB_HOST>.conf.
NGINX_CONF=

# Where the installers are on that machine: the site's /download/, which
# nginx serves itself; publish-downloads.sh puts them there. Empty:
# /srv/deneb-web/download.
DOWNLOAD_DIR=

# The credentials file certbot's dns-cloudflare plugin uses on that machine,
# as its other names do. cert-hkspare.sh passes its path to certbot and never
# reads it.
CF_CREDENTIALS=/root/.secrets/cloudflare.ini

# The address the control server sees deneb-web's requests come from (the
# public address of the machine it runs on). The control server takes a
# browser's address from X-Real-IP on requests from there, and from nowhere
# else (-trust-proxy).
WEB_PROXY_IP=198.51.100.4

# yes once https://WEB_HOST works: then deploy/control/deploy-hk155.sh starts
# the control server with -web-url and -trust-proxy, and invite links open
# the Web version. Back to no, and deploy again, to undo.
WEB_LIVE=no
