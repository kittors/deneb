# What the Web version's scripts need to know about one deployment
# (design/plan/m7/web-deploy.md). Copy this to site.hk155.env, which is not
# in the repository (.gitignore), and fill it in. The scripts read it as
# shell: NAME=value, no spaces around =.

# The name browsers reach the Web version by. Its DNS A record points at
# the server; with Cloudflare, DNS only (not proxied).
WEB_HOST=deneb.example.com

# deneb-web's port, on 127.0.0.1 only: nginx passes the name's requests to
# it. Free on hk-155 (its Deneb ports are 47443 and 47445).
WEB_PORT=47447

# The address nginx's own sites listen on, seen with: ss -ltn | grep ':443 '.
# The new site listens on the same one, so nginx binds nothing new.
NGINX_IP=103.42.31.155

# The credentials file certbot's dns-cloudflare plugin uses on the server,
# as the server's other names do. cert-hk155.sh passes its path to certbot
# and never reads it.
CF_CREDENTIALS=/root/.secrets/cloudflare.ini

# yes once https://WEB_HOST works: then deploy/control/deploy-hk155.sh starts
# the control server with -web-url and -trust-local-proxy, and invite links
# open the Web version. Back to no, and deploy again, to undo.
WEB_LIVE=no
