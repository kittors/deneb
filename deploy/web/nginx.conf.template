# deneb-web: made by deploy/web/nginx-hkspare.sh from deploy/web/nginx.conf.template
#
# The Web version of Deneb (design/plan/m7/web-deploy.md): @WEB_HOST@ over
# HTTPS, passed on to deneb-web on 127.0.0.1:@WEB_PORT@. Nothing is logged per
# request: the paths carry invite codes (/i/<code>, /api/v1/invites/<code>).
# It listens as nginx's other sites on this machine do, so it binds nothing
# new and takes no address from them; no http2 of its own.

server {
@LISTEN_80@
	server_name @WEB_HOST@;
	access_log off;
	return 301 https://$host$request_uri;
}

server {
@LISTEN_443@
	server_name @WEB_HOST@;
	ssl_certificate     /etc/letsencrypt/live/@WEB_HOST@/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/@WEB_HOST@/privkey.pem;

	access_log off;
	# An error line names its request, path and all: only what nginx itself
	# cannot go on with.
	error_log /var/log/nginx/deneb-web.error.log crit;
	client_max_body_size 1m;

	# The installers, which deploy/web/publish-downloads.sh puts in
	# @DOWNLOAD_DIR@: nginx sends them itself, ranges and all, so a
	# download that breaks can go on. The names stay the same from version
	# to version (Deneb.dmg, …), so a browser asks again each time.
	location /download/ {
		alias @DOWNLOAD_DIR@/;
		default_type application/octet-stream;
		add_header Cache-Control "no-cache" always;
		add_header X-Content-Type-Options "nosniff" always;
	}

	location / {
		proxy_pass http://127.0.0.1:@WEB_PORT@;
		proxy_http_version 1.1;
		proxy_set_header Connection "";
		proxy_set_header Host $host;
		# The address the control server's limits and log go by, set here so
		# a browser cannot choose it; deneb-web passes it on as it is, and the
		# control server takes it from this machine's address only
		# (-trust-proxy).
		proxy_set_header X-Real-IP $remote_addr;
		# deneb-web drops Secure for development over plain HTTP; this is
		# HTTPS, so the session cookie gets it back (nginx 1.19.3 or later;
		# before, proxy_cookie_path / "/; Secure"; does the same).
		proxy_cookie_flags ~ secure;
		# The view's stream, frame by frame, open for long; keep-alives come
		# every 15 s.
		proxy_buffering off;
		proxy_read_timeout 1h;
		proxy_send_timeout 1h;
	}
}
